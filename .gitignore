# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/

# Django local artifacts (never commit databases or collected assets)
db.sqlite3
db.sqlite3-journal
staticfiles/
media/*
!media/.gitkeep

# Generated secret key file (auto-created in development, see config/settings.py)
.secret_key

# Environment variable files (secrets)
.env
.env.*

# Packaging / distribution
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Testing / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
noxfile.py

# Type checkers / linters caches
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
